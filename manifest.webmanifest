{
 "name": "Musikisinaz",
 "short_name": "Musikisinaz",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#0d1118",
 "theme_color": "#0d1118",
 "lang": "tr",
 "icons": [
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./?paylas=1",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "audio",
     "accept": [
      "audio/*",
      ".mp3",
      ".m4a",
      ".aac",
      ".flac",
      ".wav",
      ".ogg",
      ".opus"
     ]
    }
   ]
  }
 }
}